{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for iGaming with strict financial correctness, persistent idempotency, and transactional outbox/inbox.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/index.ts",
    "demo": "bun run scripts/demo.ts",
    "lint": "tsc --noEmit",
    "mikro-orm": "mikro-orm"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.750.0",
    "@mikro-orm/cli": "^6.4.8",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/terminus": "^11.0.0",
    "decimal.js": "^10.5.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
