# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering_db

# AWS / LocalStack SQS
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAIN_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Background Workers
OUTBOX_PUBLISH_INTERVAL_MS=1000
PENDING_REFERENCE_RETRY_INTERVAL_MS=3000
